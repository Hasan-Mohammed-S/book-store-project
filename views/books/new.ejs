<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/style.css" />

    <title>Add a New Book</title>
</head>

<body>
    <%- include('../partials/_navbar.ejs') %>
        <h1>Add a New Books</h1>

        <form action="/books" method="POST" enctype="multipart/form-data">

           

            <label for="name">Book Name:</label>
            <input type="text" name="name" id="name" />

            <label for="price">Price:</label>
            <input type="number" name="price" id="price">

             <label for="writer">Book Writer:</label>
            <input type="text" name="writer" id="writer" />

            <label for="image">Image:</label>
          
            <input type="file" name="image" accept="image/jpeg,image/png,image/webp">


            <div class="mb-3 text-right" style="direction: rtl;">
           <label for="writer" class="form-label font-weight-bold">Select the book's author:</label>  <select class="form-select form-control" id="writer" name="writer" required>
           <option value="" disabled selected>-- Select from the library's list of authors --</option>    
           <% if (writers && writers.length > 0) { %>
          <% writers.forEach(writer => { %>
        <option value="<%= writer._id %>"><%= writer.name %></option>
       <% }) %>
    <% } %>
    
  </select>
<div class="form-text text-muted small mt-1">If the author does not exist, please add them first via the "Add New Author" page.</div></div>



            
            <button type="submit">Add the Book</button>
        </form>
</body>
</htmlt>