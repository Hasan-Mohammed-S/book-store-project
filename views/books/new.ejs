<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/style.css" />

    <title>Add a New Book</title>
</head>

<body>
    <%- include('../partials/_navbar.ejs') %>
        <h1>Add a New Books</h1>

        <form action="/users/<%=user._id%>/Books" method="POST">

            <label for="img">Book Img:</label>
            <input type="image" name="img" id="img" />

            <label for="name">Book Name:</label>
            <input type="text" name="name" id="name" />

             <label for="wraiterName">Book Writer:</label>
            <input type="text" name="wraiterName" id="wraiterName" />

            <button type="submit">Add the Book</button>
        </form>
</body>
</htmlt>