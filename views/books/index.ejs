<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/style.css">
    <title>My Books</title>
</head>
<body>
    <%- include('../partials/_navbar.ejs') %>

  <div class="book-list">
    <h1>Welcome to My Books</h1>

    <div style="text-align: center;">
        <a
            class="btn"
            href="/users/<%= user._id %>/books/new"
        >
            Add a New Book
        </a>
    </div>

    <ul>

<ul>

    <ul>
        <% books.forEach((book) => { %>
            <li>
                <a href="/users/<%= user._id %>/books/<%= book._id %>">
                    <img
                        src="<%= book.image.url %>"
                        alt="<%= book.name %>"
                        width="120"
                    />
                    <span><%= book.name %></span>
                </a>
            </li>
        <% }) %>
    </ul>
</body>
</html>
