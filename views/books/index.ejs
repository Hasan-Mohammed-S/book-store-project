<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My books</title>
</head>

<body>
    <%- include('../partials/_navbar.ejs') %>
        <h1>Welcome to my books</h1>
        <a href="/users/<%= user._id %>/books/new">Add a new book</a>
        <ul>
            <% books.forEach((book)=>{ %>
                <a href="/users/<%= user._id %>/books/<%= book._id %>">
                    <li>
                        <%=book.img%>
                        <%= book.name %>
                    </li>
                    
                </a>
                <% }) %>
        </ul>
</body>