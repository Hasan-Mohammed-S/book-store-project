<%- include('../partials/_navbar') %>

<div class="container mt-5">
    <div class="row">
        <!-- Book Details Section -->
        <div class="col-md-8 mx-auto">
            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    <h1 class="card-title fw-bold text-primary mb-2"><%= book.title %></h1>
                    <p class="text-muted mb-4">Uploaded by: <strong class="text-dark">@<%= book.user.username %></strong></p>
                    
                    <h5 class="fw-bold">Description:</h5>
                    <p class="card-text text-secondary lh-lg mb-4"><%= book.description %></p>

                    <!-- CONDITION: Only the user who uploaded the book can Edit or Delete it -->
                    <% if (user && user._id.toString() === book.user._id.toString()) { %>
                        <div class="border-top pt-3 mt-3">
                            <a href="/books/<%= book._id %>/edit" class="btn btn-warning me-2">Edit Book</a>
                            <form action="/books/<%= book._id %>?_method=DELETE" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this book?')">Delete Book</button>
                            </form>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Interaction Section (Likes & Comments Form) -->
            <div class="card shadow-sm mb-4 bg-light">
                <div class="card-body p-4">
                    <!-- Likes Feature -->
                    <div class="d-flex align-items-center mb-4">
                        <form action="/books/<%= book._id %>/like" method="POST" class="me-3">
                            <button type="submit" class="btn btn-outline-primary rounded-pill px-4">
                                👍 Like (<%= book.likes ? book.likes.length : 0 %>)
                            </button>
                        </form>
                    </div>

                    <!-- Add Comment Form (Available for logged-in users) -->
                    <% if (user) { %>
                        <div class="add-comment-box">
                            <h4 class="fw-bold text-secondary mb-3">Leave a Review / Comment:</h4>
                            <form action="/books/<%= book._id %>/comments" method="POST">
                                <div class="mb-3">
                                    <textarea name="content" class="form-control rounded-3" rows="3" placeholder="Share your thoughts about this book..." required></textarea>
                                </div>
                                <button type="submit" class="btn btn-success px-4 rounded-pill">Submit Comment</button>
                            </form>
                        </div>
                    <% } else { %>
                        <div class="alert alert-warning mb-0" role="alert">
                            Please <a href="/auth/sign-in" class="alert-link">Sign In</a> to like this book or leave a comment.
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Display Comments List -->
            <div class="card shadow-sm mb-5">
                <div class="card-body p-4">
                    <h3 class="fw-bold text-dark mb-4">Reader Reviews (<%= book.comments ? book.comments.length : 0 %>)</h3>
                    
                    <% if (!book.comments || book.comments.length === 0) { %>
                        <p class="text-muted italic">No reviews yet. Be the first to share your thoughts!</p>
                    <% } else { %>
                        <div class="comments-stream">
                            <% book.comments.forEach(comment => { %>
                                <div class="p-3 mb-3 bg-white border rounded-3 position-relative">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <strong class="text-primary">@<%= comment.user.username %></strong>
                                        <small class="text-muted">
                                            <%= new Date(comment.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                        </small>
                                    </div>
                                    <p class="text-secondary mb-2">"<%= comment.content %>"</p>
                                    
                                    <!-- CONDITION: Only the comment owner can delete their own comment -->
                                    <% if (user && user._id.toString() === comment.user._id.toString()) { %>
                                        <div class="text-end">
                                            <form action="/books/<%= book._id %>/comments/<%= comment._id %>?_method=DELETE" method="POST" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-link text-danger p-0 text-decoration-none" onclick="return confirm('Delete this comment?')">
                                                    Delete Review
                                                </button>
                                            </form>
                                        </div>
                                    <% } %>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>
            </div>

        </div>
    </div>
</div>
