<!-- Book Display Section on Homepage -->

<div class="container mt-5" style="direction: rtl; text-align: right;">

<h2 class="mb-4 text-center font-weight-bold text-dark">Featured Library Authors</h2>

<div class="row justify-content-center">

<% if (writers && writers.length > 0) { %>

<% writers.forEach(writer => { %>

<div class="col-md-3 col-sm-6 mb-4">

<!-- Clicking on the card takes you directly to the author's details page via their unique ID -->

<a href="/writers/<%= writer._id %>" class="text-decoration-none text-dark">

<div class="card h-100 text-center border-0 shadow-sm p-3 rounded-3 bg-white card-hover-effect">

<img src="<%= writer.image %>" class="card-img-top rounded-circle mx-auto shadow-sm" alt="<%= writer.name %>" style="width: 130px; height: 130px; object-fit: cover;">

<div class="card-body">

<h5 class="card-title font-weight-bold text-primary mb-1"><%= writer.name %></h5>

<p class="card-text text-muted small text-truncate"><%= writer.bio %></p>

</div>
</div>
</a>
</div>

<% }) %>

<% } else { %>

<div class="col-12 text-center py-4">

<p class="text-muted fs-5">No writers added to the database Currently.</p>

</div>

<% } %>
</div>
</div>