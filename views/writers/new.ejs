<%- include('../partials/_navbar.ejs') %>

<div class="container mt-5" style="max-width: 600px; direction: rtl; text-align: right;">
  <div class="card shadow p-4 border-0 rounded-3">
    <h2 class="mb-4 text-center text-primary font-weight-bold">New Writer</h2>
    
    <form action="/writers" method="POST" enctype="multipart/form-data">
      
      <div class="mb-3">
        <label for="name" class="form-label font-weight-bold"></label>
        <input type="text" class="form-control" id="name" name="name"  required>
      </div>
      
      <div class="mb-3">
        <label for="image" class="form-label font-weight-bold"></label>
        <input type="file" class="form-control" id="image" name="image">
      </div>
      
      <div class="mb-3">
        <label for="bio" class="form-label font-weight-bold">Write A diskreption </label>
        <textarea class="form-control" id="bio" name="bio" rows="5" ></textarea>
      </div>
      
      <button type="submit" class="btn btn-success w-100 py-2 font-weight-bold fs-5">Add the writer</button>
    </form>
  </div>
</div>
