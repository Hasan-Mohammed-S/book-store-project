<%- include('../partials/_navbar.ejs') %>

<div class="container mt-5" style="direction: rtl; text-align: right;">
  <!-- كارت تفاصيل الكاتب الأساسية -->
  <div class="row align-items-center bg-white p-4 rounded-3 shadow-sm mb-5 border">
    <div class="col-md-4 text-center mb-3 mb-md-0">
      <img src="<%= writer.image %>" alt="<%= writer.name %>" class="img-fluid rounded-circle shadow-sm" style="width: 220px; height: 220px; object-fit: cover;">
    </div>
    <div class="col-md-8">
      <h1 class="font-weight-bold text-primary mb-3"><%= writer.name %></h1>
      <h5 class="text-secondary font-weight-bold mb-2">السيرة الذاتية:</h5>
      <p class="lead text-dark style="line-height: 1.8;"><%= writer.bio %></p>
    </div>
  </div>

  <!-- قسم عرض كتب الكاتب المتوفرة بالمكتبة -->
  <div class="my-5">
    <h3 class="mb-4 text-dark font-weight-bold border-bottom pb-2">📖 مؤلفات الكاتب المتاحة لدينا:</h3>
    <div class="row">
      <% if (writer.books && writer.books.length > 0) { %>
        <% writer.books.forEach(book => { %>
          <div class="col-md-3 col-sm-6 mb-4">
            <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
              <img src="<%= book.image || 'https://placeholder.com' %>" class="card-img-top" alt="<%= book.title %>" style="height: 260px; object-fit: cover;">
              <div class="card-body d-flex flex-column justify-content-between text-center">
                <h5 class="card-title font-weight-bold text-dark"><%= book.title %></h5>
                <a href="/books/<%= book._id %>" class="btn btn-outline-primary btn-sm w-100 mt-3 rounded-pill">تصفح تفاصيل الكتاب</a>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12">
          <div class="alert alert-info text-center py-3">
            لم يتم ربط أي كتب مضافة في المكتبة لهذا الكاتب حالياً.
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>
