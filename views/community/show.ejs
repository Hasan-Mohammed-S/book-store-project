<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title><%= book.name %></title>
</head>
<body>
    <%- include('../partials/_navbar.ejs') %>

    <div>
        <!-- Publisher Information -->
        <div>
            <p>Posted by: <strong><%= poster ? poster.username : 'Unknown User' %></strong></p>
        </div>

        <!-- Book Details -->
        <div>
            <% if (book.image && book.image.url) { %>
                <img src="<%= book.image.url %>" alt="<%= book.name %>" width="250">
            <% } %>

            <div>
                <h1><%= book.name %></h1>
                <h3>Author: <%= book.writer %></h3>
                <p><%= book.description %></p>

                <!-- Like Button (Heart) -->
                <div>
                    <% const hasLiked = user && book.likes.some(like => like.toString() === user._id.toString()); %>
                    <form action="/community/<%= book._id %>/like" method="POST">
                        <button type="submit" aria-label="<%= hasLiked ? 'Unlike book' : 'Like book' %>">
                            <%= hasLiked ? '❤️' : '🤍' %>
                        </button>
                    </form>
                    <span><%= book.likes.length %> Likes</span>
                </div>
            </div>
        </div>

        <!-- Comments Section -->
        <div>
            <h2>Comments</h2>

            <!-- Add Comment Form -->
            <form action="/community/<%= book._id %>/comments" method="POST">
                <textarea name="content" rows="3" placeholder="Write a comment..." required></textarea>
                <button type="submit">Add Comment</button>
            </form>

            <!-- Comments List -->
            <div>
                <% if (comments.length > 0) { %>
                    <% comments.forEach(comment => { %>
                        <div>
                            <strong><%= comment.userId ? comment.userId.username : 'User' %></strong>
                            <p><%= comment.comment %></p>

                            <% if (comment.userId && comment.userId._id.toString() === user._id.toString()) { %>
                                <form action="/community/<%= book._id %>/comments/<%= comment._id %>?_method=DELETE" method="POST">
                                    <button type="submit">Delete Comment</button>
                                </form>
                            <% } %>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p>No comments yet. Be the first to comment!</p>
                <% } %>
            </div>
        </div>
    </div>
</body>
</html>
