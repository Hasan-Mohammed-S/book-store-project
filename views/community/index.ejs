<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/style.css">
    <title>My Books</title>
</head>


<body>
<%- include('../partials/_navbar') %>
<link rel="stylesheet" href="/css/style.css">
<main class="browse-container">
  <div class="browse-header">
    <h1>Community Recommendations</h1>
    <% if (user) { %>
      <a href="/users/<%= user._id %>/books/new" class="btn primary-btn">Share a Book</a>
    <% } %>
  </div>

  <% if (books.length === 0) { %>
    <div class="empty-state-container">
      <div class="empty-state-icon">💬</div>
      <p class="empty-state-text">Looks empty... why don't you be the first to share your favorite book?</p>
    </div>
  <% } else { %>
    <div class="browse-grid">
      <% books.forEach((book) => { %>
        <article class="book-card">
          
          <div class="poster-details">
            <% const poster = users.find(u => u.books.some(bId => bId.toString() === book._id.toString())) %>
            <span class="poster-username">Posted by: <%= poster ? poster.username : 'Community Member' %></span>
          </div>

          <a href="/community/<%= book._id %>" class="book-card-link">
            <% if (book.image && book.image.url) { %>
              <div class="book-cover-wrapper">
                <img class="book-cover" src="<%= book.image.url %>" alt="<%= book.name %> cover">
              </div>
            <% } %>
            
            <div class="book-info">
              <h2 class="book-title"><%= book.name %></h2>
              <h3 class="book-author">by <%= book.writer %></h3>
              <p class="book-price">$<%= book.price %></p>
              
              <% if (book.description) { %>
                <p class="book-summary"><%= book.description %></p>
              <% } %>
            </div>
          </a>

        </article>
      <% }) %>
    </div>
  <% } %>
</main>

</body>